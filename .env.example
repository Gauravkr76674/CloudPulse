# Copy to .env and fill in. Never commit the real .env (.gitignore already excludes it).
# Load it before starting the backend, e.g.:
#   Linux/macOS : set -a && source .env && set +a && mvn spring-boot:run
#   PowerShell  : Get-Content .env | % { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1],$matches[2]) } }
#
# Every variable here has a working default in application.yml, so the app starts
# even with no .env at all. A variable left EMPTY (e.g. `AI_API_KEY=`) overrides the
# default with an empty string; to fall back to the default instead, comment the
# line out entirely.
#
# The values below are safe for a laptop only: the database password matches the
# throwaway MySQL in docker-compose.yml and the admin password is the documented
# demo credential. Change both before anything else can reach this app.

# ---------- server ----------
SERVER_PORT=8080

# ---------- database ----------
# matches the mysql service in docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudops
DB_USERNAME=cloudops
DB_PASSWORD=cloudops

# ---------- security ----------
# HS256 needs at least 32 bytes; the app refuses to start on a blank or shorter one.
# Generate a real secret and uncomment:  openssl rand -base64 48
# Left commented so the (clearly labelled) dev placeholder in application.yml is
# used locally and no usable secret is ever committed to the repository.
#JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
# Bootstrap admin: created on first start only while the users table has no ADMIN.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_EMAIL=admin@cloudops.local
# also create the demo operator/viewer accounts (see db/seed.sql)
SEED_DEMO_USERS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- cloud provider ----------
# mock = no AWS needed; aws = real account via the default credential chain
CLOUD_PROVIDER=mock
AWS_REGION=ap-south-1
# Credentials are NEVER read from this file by the app: use `aws configure`,
# ~/.aws/credentials, an EC2 instance role, or real environment variables
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) picked up by DefaultCredentialsProvider.
AWS_PROFILE=
# tag name/value that marks an instance for auto-import (not a credential)
AWS_DISCOVERY_TAG_KEY=CloudOpsMonitored
AWS_DISCOVERY_TAG_VALUE=true
AWS_DISCOVERY_TAG_FILTER_ENABLED=true

# ---------- monitoring / detection ----------
MONITORING_ENABLED=true
MONITORING_POLL_INTERVAL_MS=300000
DETECTION_CPU_THRESHOLD=90
DETECTION_CONSECUTIVE_BREACHES=2

# ---------- AI ----------
# stub = offline deterministic analyser; http = OpenAI-compatible endpoint
AI_PROVIDER=stub
AI_BASE_URL=https://api.openai.com/v1
# required only when AI_PROVIDER=http — paste the key here, never into source
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
# Optional per-stage model overrides (multi-model routing). Empty = use AI_MODEL.
# A cheap fast model for triage and a stronger one for diagnosis is the usual split.
AI_MODEL_DETECTION=
AI_MODEL_DIAGNOSIS=
AI_MODEL_RECOMMENDATION=
AI_MODEL_VERIFICATION=

# ---------- remediation safety ----------
REMEDIATION_ENABLED=true
REMEDIATION_FORCE_DRY_RUN=false
IAM_PREFLIGHT_ENABLED=true
